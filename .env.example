# Copy to .env (git-ignored) and fill in what you need; docker compose reads
# it. Everything has a default, so the app also runs without a .env.

# Claude. Without a key, LLM_PROVIDER=auto runs the demo model and the UI
# shows a "MOCK LLM" banner. LLM_PROVIDER=anthropic refuses to start without
# a key; LLM_PROVIDER=mock always uses the demo model.
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# The router (intent and target campaigns) uses the same model by default,
# at a lower effort.
LLM_ROUTER_MODEL=
LLM_ROUTER_EFFORT=low

# Fake recipients loaded into an empty database.
SEED_USERS=5000

# Channel limits, shared by every worker (calls per second).
SMS_RATE_PER_SECOND=100
EMAIL_RATE_PER_SECOND=100

# How the mock provider misbehaves: fractions of requests per fault
# (reject_429, reject_400, fail_503, accept_then_503, accept_then_drop,
# delay). A selected delay records the acceptance, then waits before replying.
# Set it empty for a provider that never fails.
MOCKPROVIDER_FAULTS=reject_429=0.02,fail_503=0.01,accept_then_503=0.01,accept_then_drop=0.005,delay=0.01
MOCKPROVIDER_DELAY=200ms

# Local days of the overview's charts (an IANA zone).
APP_TIMEZONE=Europe/Istanbul

LOG_LEVEL=info
